# Copie este arquivo para ".env" no computador ou cadastre as variáveis na Vercel
# (Project Settings → Environment Variables). Nunca coloque as chaves no código.

# Envio de e-mail do formulário (resend.com → API Keys)
RESEND_API_KEY=
# Quem recebe as mensagens (padrão: o e-mail cadastrado no painel)
CONTACT_TO=
# Remetente, de um domínio verificado no Resend. Ex.: Site <contato@pantolfi.com.br>
CONTACT_FROM=

# Proteção contra spam (dash.cloudflare.com → Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

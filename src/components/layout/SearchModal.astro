---
import Icon from '@/components/ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<dialog id="site-search" class="search" aria-labelledby="search-title" data-search>
  <div class="search-inner">
    <div class="search-top">
      <h2 id="search-title" class="caps search-title">
        {t('search.label')}
      </h2>
      <button type="button" class="search-close" data-search-close>
        <span class="caps">{t('search.close')}</span>
        <Icon name="close" size={26} />
      </button>
    </div>
    <form role="search" class="search-form" data-search-form>
      <label for="search-input" class="visually-hidden">
        {t('search.label')}
      </label>
      <Icon name="search" size={28} class="search-icon" />
      <input
        id="search-input"
        type="search"
        name="q"
        autocomplete="off"
        spellcheck="false"
        placeholder={t('search.placeholder')}
        data-search-input
      />
    </form>
    <p class="search-hint">{t('search.hint')}</p>
    <div class="search-results" aria-live="polite" data-search-results></div>
  </div>
</dialog>

<style>
  .search {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-silver);
    background: var(--color-primary);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }

  .search[open] {
    opacity: 1;
  }

  @starting-style {
    .search[open] {
      opacity: 0;
    }
  }

  .search::backdrop {
    background: transparent;
  }

  .search-inner {
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-md) var(--gutter) var(--space-xl);
  }

  .search-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: calc(var(--header-height) - var(--space-md));
  }

  .search-title {
    margin: 0;
    color: var(--color-gold);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-caps);
  }

  .search-close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    color: var(--color-white);
    background: none;
    border: 0;
    cursor: pointer;
    font-size: var(--text-label);
  }

  .search-close:hover {
    color: var(--color-gold);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: clamp(3rem, 10vh, 7rem);
    border-bottom: var(--line-width) solid var(--color-gold);
  }

  .search-form :global(.search-icon) {
    flex: none;
    color: var(--color-gold);
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    padding-block: var(--space-sm);
    color: var(--color-white);
    background: none;
    border: 0;
    font-family: var(--font-body);
    font-size: clamp(1.375rem, 2.6vw + 0.75rem, 3.25rem);
    font-weight: var(--weight-light);
    outline: none;
  }

  .search-form input::placeholder {
    color: var(--color-muted);
  }

  .search-form:focus-within {
    outline: var(--line-width) solid var(--color-gold);
    outline-offset: 6px;
  }

  .search-hint {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>

---
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';
import { headerNavItems, isActive } from '@/lib/navigation';
import { phoneHref, settings } from '@/lib/site';

interface Props {
  /** true quando a página abre com imagem em tela cheia (cabeçalho translúcido no topo). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
---

<header
  class="site-header"
  data-header
  data-overlay={overlay ? 'true' : 'false'}
  data-solid={overlay ? 'false' : 'true'}
>
  <div class="bar">
    <div class="start">
      <button
        type="button"
        class="icon-button"
        data-menu-open
        aria-controls="site-menu"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <Icon name="menu" size={26} />
        <span class="visually-hidden">{t('menu.open')}</span>
      </button>
      <a
        href={localizePath('/', lang)}
        class="brand"
        aria-label={`${settings.nome} — ${t('a11y.home')}`}
      >
        <Logo variant="horizontal" height={44} class="brand-full" eager />
        <Logo variant="simbolo" height={36} class="brand-mark" eager />
      </a>
    </div>

    <nav class="center" aria-label={t('nav.main')}>
      <ul>
        {headerNavItems.map((item) => (
          <li>
            <a
              href={localizePath(item.href, lang)}
              class="link-line"
              aria-current={isActive(item.href, pathname) ? 'page' : undefined}
            >
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="end">
      {settings.inglesAtivo && (
        <a
          href={lang === 'en' ? '/' : '/en'}
          class="lang caps link-line"
          hreflang={lang === 'en' ? 'pt-BR' : 'en'}
          lang={lang === 'en' ? 'pt-BR' : 'en'}
          aria-label={t('header.language')}
        >
          {lang === 'en' ? 'PT' : 'EN'}
        </a>
      )}
      <a
        href={phoneHref}
        class="icon-button"
        aria-label={`${t('header.call')} ${settings.telefone}`}
      >
        <Icon name="phone" size={22} />
      </a>
      <button
        type="button"
        class="search-button"
        data-search-open
        aria-controls="site-search"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-keyshortcuts="/"
      >
        <Icon name="search" size={20} />
        <span class="visually-hidden">{t('search.open')}</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-height);
    color: var(--color-white);
    background-color: var(--color-primary);
    border-bottom: var(--line-width) solid var(--color-line);
    transition:
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  /* Sobre a imagem do hero: translúcido até 80px de rolagem */
  .site-header[data-solid='false'] {
    background-color: var(--color-primary-glass);
    border-bottom-color: transparent;
  }

  /* Some ao rolar para baixo, volta ao rolar para cima */
  .site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-md);
    height: 100%;
    padding-inline: var(--gutter);
  }

  .start,
  .end {
    display: flex;
    align-items: center;
  }

  .start {
    gap: var(--space-sm);
  }

  .end {
    justify-content: flex-end;
    gap: var(--space-xs);
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .brand :global(img) {
    height: var(--logo-height);
    width: auto;
  }

  .brand :global(.brand-full) {
    display: none;
  }

  .center {
    display: none;
  }

  .center ul {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .center a {
    font-size: 0.9375rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-white);
    /* sublinhado na cor de destaque */
    background-image: linear-gradient(var(--color-gold), var(--color-gold));
  }

  .icon-button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-white);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .icon-button:hover {
    color: var(--color-gold);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding-inline: var(--space-xs);
    font-size: var(--text-label);
  }

  /* Lupa na cor de destaque dentro de um círculo escuro */
  .search-button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: var(--space-xs);
    color: var(--color-gold);
    background: var(--color-graphite);
    border: var(--line-width) solid transparent;
    border-radius: 50%;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .search-button:hover {
    border-color: var(--color-gold);
  }

  @media (min-width: 768px) {
    .brand :global(.brand-mark) {
      display: none;
    }
    .brand :global(.brand-full) {
      display: block;
    }
  }

  @media (min-width: 1100px) {
    .bar {
      grid-template-columns: 1fr auto 1fr;
    }
    .center {
      display: block;
    }
  }
</style>

---
/**
 * Metadados de cada página. Sem <meta name="generator">.
 * Inclui título, descrição, endereço canônico, Open Graph, Twitter e dados estruturados.
 * Quando o inglês for ativado, acrescentar aqui os links hreflang entre as versões.
 */
import { PUBLIC_PLAUSIBLE_DOMAIN } from 'astro:env/client';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { siteGraph } from '@/lib/jsonld';
import { settings } from '@/lib/site';

interface Props {
  title?: string | undefined;
  description: string;
  noindex?: boolean;
  /** imagem de compartilhamento (caminho no site); padrão: /og/padrao.png */
  image?: string | undefined;
  type?: 'website' | 'article' | undefined;
  /** dados estruturados específicos da página */
  jsonLd?: Record<string, unknown>[] | undefined;
}

const {
  title,
  description,
  noindex = false,
  image = '/og/padrao.png',
  type = 'website',
  jsonLd = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://pantolfi.com.br');
// Evita que um texto com "</script>" encerre o bloco antes da hora.
const toJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
const imageUrl = new URL(image, Astro.site);
const t = useTranslations(getLangFromUrl(Astro.url));
const fullTitle = title
  ? `${title} — ${settings.nome} | ${t('site.role')}`
  : `${settings.nome} | ${settings.posicionamento}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#031822" />
<meta name="format-detection" content="telephone=no" />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${settings.nome} — Publicações`}
  href="/rss.xml"
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.nome} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={toJson(siteGraph(site))} />
{jsonLd.map((data) => (
  <script type="application/ld+json" set:html={toJson(data)} />
))}

{
  /* Métricas de visitas sem cookies (Plausible), só quando o domínio estiver configurado */
  PUBLIC_PLAUSIBLE_DOMAIN && (
    <script
      is:inline
      defer
      data-domain={PUBLIC_PLAUSIBLE_DOMAIN}
      src="https://plausible.io/js/script.js"
    />
  )
}

---
/**
 * Mostra de forma visível um dado que ainda falta preencher.
 * Formato: [PREENCHER: descrição] ou [PREENCHER: descrição — ex.: texto sugerido].
 * Quando há sugestão, ela aparece destacada para dar ideia do resultado final.
 * Se o texto já estiver preenchido, ele aparece normalmente.
 */
import { placeholderDisplay } from '@/lib/site';

interface Props {
  value: string;
}

const { value } = Astro.props;
const { pending, text } = placeholderDisplay(value);
---

{pending ? (
  <mark class="placeholder" title={value}>
    {text}
  </mark>
) : (
  text
)}

<style is:global>
  /* global: também usado no título do hero (src/components/sections/Hero.astro) */
  .placeholder {
    background: color-mix(in srgb, var(--color-gold) 22%, transparent);
    color: inherit;
    font: inherit;
    padding-inline: 0.15em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>

---
/**
 * Mostra de forma visível um dado que ainda falta preencher.
 * Formato: [PREENCHER: descrição] ou [PREENCHER: descrição — ex.: texto sugerido].
 * Quando há sugestão, ela aparece contornada para dar ideia do resultado final.
 * Se o texto já estiver preenchido, ele aparece normalmente.
 */
import { isPlaceholder } from '@/lib/site';

interface Props {
  value: string;
}

const { value } = Astro.props;
const pending = isPlaceholder(value);
const example = pending ? /—\s*ex\.:\s*(.+)\]$/.exec(value)?.[1]?.trim() : undefined;
---

{pending ? (
  <mark class="placeholder" title={value}>
    {example ?? value}
  </mark>
) : (
  value
)}

<style>
  .placeholder {
    background: none;
    color: inherit;
    font: inherit;
    outline: var(--line-width) dashed var(--color-gold);
    outline-offset: 0.12em;
    padding-inline: 0.15em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>

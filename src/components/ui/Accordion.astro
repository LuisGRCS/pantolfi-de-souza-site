---
/** Perguntas e respostas em acordeão nativo (<details>): funciona sem JavaScript. */
import Placeholder from './Placeholder.astro';

interface Props {
  items: { pergunta: string; resposta: string }[];
}

const { items } = Astro.props;
---

<div class="accordion" data-reveal-group>
  {items.map((item) => (
    <details class="rule-top" data-reveal>
      <summary>
        <span>
          <Placeholder value={item.pergunta} />
        </span>
        <span class="accordion-icon" aria-hidden="true" />
      </summary>
      <div class="accordion-body">
        <p>
          <Placeholder value={item.resposta} />
        </p>
      </div>
    </details>
  ))}
</div>

<style>
  .accordion {
    border-bottom: var(--line-width) solid var(--color-line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-md);
    color: var(--color-white);
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--color-gold);
  }

  /* Sinal de + que vira − ao abrir */
  .accordion-icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .accordion-icon::before,
  .accordion-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: var(--line-width);
    background: var(--color-gold);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .accordion-icon::after {
    transform: rotate(90deg);
  }

  details[open] .accordion-icon::after {
    transform: rotate(0deg);
  }

  .accordion-body p {
    max-width: var(--measure);
    margin: 0;
    padding-bottom: var(--space-lg);
  }

  /* Abertura suave onde o navegador permite */
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--duration-base) var(--ease-out),
        content-visibility var(--duration-base) allow-discrete;
    }
    details[open]::details-content {
      height: auto;
    }
  }
</style>

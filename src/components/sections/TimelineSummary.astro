---
import LinkArrow from '@/components/ui/LinkArrow.astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';
import { getTimeline } from '@/lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const milestones = (await getTimeline()).filter((item) => item.data.destaque).slice(0, 5);
---

<section
  class="section surface-paper"
  data-section
  data-surface="paper"
  aria-labelledby="career-title"
>
  <div class="container-site grid-12">
    <h2 id="career-title" class="section-label col-label">
      {t('home.career')}
    </h2>
    <div class="col-content">
      <ol class="milestones" data-reveal-group>
        {milestones.map((item) => (
          <li class="milestone rule-top" data-draw-line data-reveal>
            <span class="index-num milestone-period">
              <Placeholder value={item.data.periodo} />
            </span>
            <span class="milestone-main">
              <span class="milestone-role">
                <Placeholder value={item.data.cargo} />
              </span>
              <span class="milestone-place">
                <Placeholder value={item.data.instituicao} />
              </span>
            </span>
          </li>
        ))}
      </ol>
      <div class="milestones-link" data-reveal>
        <LinkArrow href={localizePath('/trajetoria', lang)}>{t('home.career.link')}</LinkArrow>
      </div>
    </div>
  </div>
</section>

<style>
  .milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: var(--line-width) solid var(--color-line-ink);
  }

  .milestone {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-md);
  }

  .milestone-main {
    display: grid;
    gap: 0.15rem;
  }

  .milestone-role {
    color: var(--color-ink);
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
    line-height: 1.3;
  }

  .milestone-place {
    font-size: var(--text-small);
  }

  .milestones-link {
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .milestone {
      grid-template-columns: minmax(0, 2fr) minmax(0, 7fr);
      column-gap: var(--grid-gap);
      align-items: baseline;
    }
  }
</style>

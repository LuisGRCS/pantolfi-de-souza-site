---
/**
 * Sumário gerado pelos subtítulos do texto. No computador fica fixo ao lado
 * e destaca o trecho em leitura; no celular vira um bloco recolhível.
 */
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const t = useTranslations(getLangFromUrl(Astro.url));
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
const clean = (text: string) => text.replace(/^\[PREENCHER:\s*(.*)\]$/, '[PREENCHER: $1]');
---

{headings.length > 1 && (
  <nav class="toc" aria-labelledby="toc-title" data-toc data-pagefind-ignore>
    <details class="toc-details" data-toc-details>
      <summary id="toc-title" class="section-label">
        {t('pub.toc')}
      </summary>
      <ol>
        {headings.map((heading) => (
          <li class:list={[`toc-depth-${heading.depth}`]}>
            <a href={`#${heading.slug}`} data-toc-link>
              {clean(heading.text)}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<script>
  function initToc() {
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (!toc) return;
    const details = toc.querySelector<HTMLDetailsElement>('[data-toc-details]');
    const desktop = window.matchMedia('(min-width: 1024px)');
    // Começa recolhido (celular); no computador, onde fica numa coluna própria, abre.
    if (details) details.open = desktop.matches;

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) =>
      links.forEach((link) =>
        link.toggleAttribute('aria-current', decodeURIComponent(link.hash.slice(1)) === id),
      );

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
    if (targets[0]) setActive(targets[0].id);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  .toc {
    font-size: var(--text-small);
  }

  summary {
    padding-block: var(--space-sm);
    cursor: pointer;
    list-style: none;
    border-top: var(--line-width) solid var(--color-line);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    float: right;
    color: var(--color-gold);
  }

  details[open] summary::after {
    content: '−';
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-md);
    display: grid;
    gap: 0.25rem;
  }

  .toc-depth-3 {
    padding-left: var(--space-sm);
  }

  a {
    display: block;
    padding-block: 0.25rem;
    padding-left: var(--space-sm);
    border-left: var(--line-width) solid var(--color-line);
    color: var(--color-muted);
    line-height: 1.4;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  a:hover,
  a[aria-current] {
    color: var(--color-white);
    border-color: var(--color-gold);
  }

  @media (min-width: 1024px) {
    .toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-lg));
    }
    summary {
      pointer-events: none;
    }
    summary::after {
      display: none;
    }
  }
</style>

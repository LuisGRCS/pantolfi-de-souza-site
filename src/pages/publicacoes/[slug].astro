---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import AuthorBox from '@/components/publications/AuthorBox.astro';
import PublicationCard from '@/components/publications/PublicationCard.astro';
import ReadingProgress from '@/components/publications/ReadingProgress.astro';
import ShareLinks from '@/components/publications/ShareLinks.astro';
import TableOfContents from '@/components/publications/TableOfContents.astro';
import VideoEmbed from '@/components/publications/VideoEmbed.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAreaNames } from '@/lib/content';
import {
  formatDate,
  getPublications,
  isEventType,
  isoDate,
  readingMinutes,
  relatedTo,
  typeKey,
} from '@/lib/publications';
import { isPlaceholder, placeholderDisplay } from '@/lib/site';

export const getStaticPaths = (async () => {
  const all = await getPublications();
  return all.map((publication) => ({
    params: { slug: publication.id },
    props: { publication, related: relatedTo(publication, all) },
  }));
}) satisfies GetStaticPaths;

const { publication, related } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { data } = publication;
const { Content, headings } = await render(publication);
const areaNames = await getAreaNames();
const title = placeholderDisplay(data.titulo).text;
const minutes = readingMinutes(publication.body);
const eventType = isEventType(data.tipo);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const hasBody = Boolean(publication.body?.trim());

// Compartilhamento: a capa (recortada em 1200×630) ou a imagem gerada com o título.
const shareImage = data.capa
  ? (await getImage({ src: data.capa, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : `/og/${publication.id}.png`;

const seoDescription = data.seo?.descricao ?? data.resumo;
const description = isPlaceholder(seoDescription) ? title : seoDescription;
---

<BaseLayout
  searchGroup={t('nav.publications')}
  title={data.seo?.titulo ?? title}
  description={description}
  image={shareImage}
  type="article"
>
  <ReadingProgress />

  <article data-article>
    <header class="article-header" data-section>
      <div class="container-site grid-12">
        <Breadcrumb
          items={[
            { label: t('nav.publications'), href: localizePath('/publicacoes', lang) },
            { label: title },
          ]}
        />
        <p class="article-meta" data-pagefind-ignore>
          <span class="index-num">{t(typeKey(data.tipo))}</span>
          <time datetime={isoDate(data.data)}>{formatDate(data.data)}</time>
          {hasBody && (
            <span>
              {minutes} {t('pub.reading')}
            </span>
          )}
        </p>
        <h1 class="article-title">
          <Placeholder value={data.titulo} />
        </h1>
        <p class="lead article-summary col-text" data-reveal>
          <Placeholder value={data.resumo} />
        </p>
      </div>
    </header>

    <div class="container-site grid-12 article-body-grid" data-section>
      <aside class="article-aside">
        <TableOfContents headings={headings} />
      </aside>

      <div class="article-main">
        {(eventType || data.veiculo || data.linkExterno || data.pdf || data.video) && (
          <div class="article-facts rule-top" data-pagefind-ignore>
            <dl>
              {eventType && (
                <div>
                  <dt class="section-label">{t('pub.date')}</dt>
                  <dd>{formatDate(data.data)}</dd>
                </div>
              )}
              {data.veiculo && (
                <div>
                  <dt class="section-label">{t('pub.where')}</dt>
                  <dd>
                    <Placeholder value={data.veiculo} />
                  </dd>
                </div>
              )}
            </dl>
            {data.video && <VideoEmbed url={data.video} title={title} />}
            <p class="article-links">
              {data.linkExterno && (
                <a class="link-line" href={data.linkExterno} target="_blank" rel="noopener">
                  {t('pub.external')}
                </a>
              )}
              {data.pdf && (
                <a class="link-line" href={data.pdf} download>
                  {t('pub.pdf')}
                </a>
              )}
            </p>
          </div>
        )}

        {hasBody && (
          <div class="prose">
            <Content />
          </div>
        )}

        <p class="disclaimer">{t('pub.disclaimer')}</p>

        <ShareLinks url={pageUrl} title={title} />
        <AuthorBox />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section
      class="section related"
      data-section
      data-pagefind-ignore
      aria-labelledby="related-title"
    >
      <div class="container-site grid-12">
        <h2 id="related-title" class="section-label col-label">
          {t('pub.related')}
        </h2>
        <ul class="col-content related-list" data-reveal-group>
          {related.map((item) => (
            <li data-reveal>
              <PublicationCard publication={item} areaNames={areaNames} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-header {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    font-size: var(--text-small);
  }

  .article-title {
    margin: 0;
    max-width: 24ch;
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
  }

  .article-summary {
    max-width: 52ch;
  }

  .article-body-grid {
    padding-bottom: var(--space-section);
    align-items: start;
  }

  .article-main {
    display: grid;
    gap: var(--space-xl);
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .article-body-grid > .article-aside {
      grid-column: 1 / span 3;
      align-self: stretch;
    }
    .article-body-grid > .article-main {
      grid-column: 4 / span 7;
    }
  }

  .article-facts {
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
    padding-top: var(--space-md);
  }

  .article-facts dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    margin: 0;
  }

  .article-facts dd {
    margin: var(--space-xs) 0 0;
    color: var(--color-white);
  }

  .article-facts .section-label {
    font-size: var(--text-label);
  }

  .article-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
  }

  .article-links:empty {
    display: none;
  }

  .disclaimer {
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-md) 0 0;
    border-top: var(--line-width) solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-small);
    font-style: italic;
  }

  .related {
    border-top: var(--line-width) solid var(--color-line);
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
  }

  @media (min-width: 768px) {
    .related-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

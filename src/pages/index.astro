---
import Hero from '@/components/sections/Hero.astro';
import inicio from '@/content/paginas/inicio.json';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isPlaceholder, settings } from '@/lib/site';

const description = isPlaceholder(inicio.descricao)
  ? `${settings.nome} — ${settings.posicionamento}. ${settings.cidade}.`
  : inicio.descricao;
---

<BaseLayout description={description} overlayHeader>
  <Hero tagline={inicio.tagline} />
</BaseLayout>

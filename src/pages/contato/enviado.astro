---
/** Resultado do envio quando o navegador está sem JavaScript. */
import PageHeader from '@/components/sections/PageHeader.astro';
import LinkArrow from '@/components/ui/LinkArrow.astro';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('contact.sent.title')} description={t('contact.sent.text')} noindex>
  <PageHeader title={t('contact.sent.title')} lead={t('contact.sent.text')} />
  <div class="container-site back">
    <LinkArrow href={localizePath('/', lang)}>{t('nav.home')}</LinkArrow>
  </div>
</BaseLayout>

<style>
  .back {
    padding-bottom: var(--space-section);
  }
</style>

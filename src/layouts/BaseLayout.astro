---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import MenuOverlay from '@/components/layout/MenuOverlay.astro';
import SearchModal from '@/components/layout/SearchModal.astro';
import Seo from '@/components/layout/Seo.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import SectionIndex from '@/components/ui/SectionIndex.astro';
import { getLangFromUrl, languages } from '@/i18n/utils';

interface Props {
  /** Nome da página (vira "[Página] — Luis Eduardo Pantolfi de Souza | Advogado"). */
  title?: string | undefined;
  description: string;
  /** true quando a página abre com imagem em tela cheia sob o cabeçalho. */
  overlayHeader?: boolean;
  noindex?: boolean;
  image?: string | undefined;
  type?: 'website' | 'article' | undefined;
}

const { title, description, overlayHeader = false, noindex = false, image, type } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={languages[lang]}>
  <head>
    <Seo title={title} description={description} noindex={noindex} image={image} type={type} />
    <script is:inline transition:persist="movimento-inicial">
      // Ativa o movimento só com JavaScript e sem pedido de movimento reduzido.
      // A abertura aparece uma única vez por sessão. Se o movimento não carregar
      // em 4 segundos, o conteúdo é exibido mesmo assim.
      (function () {
        const root = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion-ok');
        try {
          if (!sessionStorage.getItem('pps-abertura')) {
            root.classList.add('intro');
            sessionStorage.setItem('pps-abertura', '1');
          }
        } catch {
          // sem acesso ao armazenamento da sessão: a abertura não é exibida
        }
        setTimeout(function () {
          if (!root.hasAttribute('data-motion-ready')) root.classList.remove('motion-ok', 'intro');
        }, 4000);
      })();
    </script>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="intro-curtain" aria-hidden="true">
      <img src="/marca/simbolo_dourado-fundo-escuro.svg" width="80" height="89" alt="" />
    </div>
    <SkipLink />
    <Header overlay={overlayHeader} />
    <main id="conteudo" tabindex="-1" class:list={{ 'offset-header': !overlayHeader }}>
      <slot />
    </main>
    <Footer />
    <SectionIndex />
    <MenuOverlay />
    <SearchModal />
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>

<style>
  .offset-header {
    padding-top: var(--header-height);
  }

  main:focus {
    outline: none;
  }
</style>

---
/** Política de Privacidade e Aviso Legal: texto editável no painel. */
import { getEntry, render } from 'astro:content';
import PageHeader from '@/components/sections/PageHeader.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, isoDate } from '@/lib/publications';
import { settings } from '@/lib/site';

interface Props {
  id: 'privacidade' | 'aviso-legal';
}

const t = useTranslations(getLangFromUrl(Astro.url));
const entry = await getEntry('legais', Astro.props.id);
if (!entry) throw new Error(`Página ${Astro.props.id} não encontrada em src/content/paginas.`);
const { Content } = await render(entry);
const { titulo, atualizadoEm, emRevisao } = entry.data;
---

<BaseLayout
  title={titulo}
  description={`${titulo} do site de ${settings.nome}.`}
  noindex={emRevisao}
>
  <PageHeader title={titulo} />
  <section class="section legal" data-section aria-label={titulo}>
    <div class="container-site grid-12">
      <div class="col-text">
        {emRevisao && (
          <p class="draft" role="note">
            {t('legal.draft')}
          </p>
        )}
        <p class="updated">
          {t('legal.updated')}{' '}
          <time datetime={isoDate(atualizadoEm)}>{formatDate(atualizadoEm)}</time>
        </p>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-top: 0;
  }

  .draft {
    margin: 0 0 var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    color: var(--color-white);
    border-left: var(--line-width) solid var(--color-gold);
    background: color-mix(in srgb, var(--color-gold) 12%, transparent);
    font-size: var(--text-small);
  }

  .updated {
    margin: 0 0 var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
